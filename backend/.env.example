# ==============================================================================
# Personal AI Agent (Operon) V1 - Backend Environment Configuration Template
# Strictly adheres to Protocol 64 (Strict BYOK Production Isolation)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (Required in all environments)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required in all environments)
# MongoDB Replica Set connection string (required for transactions & checkpointers)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/operon_v1?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Required in all environments)
# Minimum 32-character high-entropy cryptographic secrets
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_minimum_32_character_jwt_access_secret_here
JWT_REFRESH_SECRET=your_minimum_32_character_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Dedicated 256-bit AES symmetric key for envelope encryption of BYOK credentials at rest (Protocol 22, 64)
# In production, this MUST be explicitly set (never rely on JWT_ACCESS_SECRET fallback).
ENCRYPTION_KEY=your_minimum_32_character_aes_encryption_key_here

# ------------------------------------------------------------------------------
# 4. GOOGLE SSO OAUTH CREDENTIALS (Required for Google Single Sign-On)
# ------------------------------------------------------------------------------
GOOGLE_SSO_CLIENT_ID=your_google_sso_client_id_here
GOOGLE_SSO_CLIENT_SECRET=your_google_sso_client_secret_here
GOOGLE_SSO_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/sso/callback

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE CLOUD STORAGE INTEGRATION (Protocol 34, 66)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret_here
GOOGLE_DRIVE_CALLBACK_URL=http://localhost:4000/api/v1/users/integrations/google-drive/callback

# ==============================================================================
# DEVELOPMENT-ONLY TESTING CREDENTIALS (Protocol 64)
# NOTE: In production environments, DO NOT set these variables!
# In production, all AI provider API keys and connector secrets must be supplied
# exclusively by authenticated users through the UI as Bring-Your-Own-Key (BYOK)
# credentials, stored envelope-encrypted (AES-256-GCM) in MongoDB.
# ==============================================================================
# GEMINI_DEVELOPMENT_ONLY_API_KEY=
# ADDIS_AI_DEVELOPMENT_ONLY_API_KEY=
# TELEGRAM_DEVELOPMENT_ONLY_ENABLED=false
# TELEGRAM_DEVELOPMENT_ONLY_BOT_TOKEN=
# TELEGRAM_DEVELOPMENT_ONLY_MANAGEMENT_CHAT_ID=
# TELEGRAM_DEVELOPMENT_ONLY_MAINTENANCE_CHAT_ID=
# TELEGRAM_DEVELOPMENT_ONLY_GENERAL_CHAT_ID=
# CLOUDINARY_DEVELOPMENT_ONLY_CLOUD_NAME=
# CLOUDINARY_DEVELOPMENT_ONLY_API_KEY=
# CLOUDINARY_DEVELOPMENT_ONLY_API_SECRET=
# CLOUDINARY_DEVELOPMENT_ONLY_URL=
