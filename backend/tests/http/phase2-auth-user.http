### 8. Session Renewal - Protocol 17 Silent Refresh (Rotates HttpOnly Cookies)
# @name refreshSuccess
# Expected Response:
#   HTTP/1.1 200 OK
#   Set-Cookie: accessToken=...; Path=/; HttpOnly; SameSite=Lax
#   Set-Cookie: refreshToken=...; Path=/; HttpOnly; SameSite=Lax
#   {
#     "success": true,
#     "message": "Session renewed successfully.",
#     "data": {
#       "user": { "email": "operon.architect@example.com" }
#     }
#   }
POST {{authUrl}}/refresh HTTP/1.1
Accept: application/json

###

### 9. Session Renewal - Missing Token Rejection
# @name refreshMissingToken
# Expected Response:
#   HTTP/1.1 401 Unauthorized
POST {{authUrl}}/refresh HTTP/1.1
Accept: application/json
Cookie: accessToken=invalid; refreshToken=

###

### 9a. Google SSO Initiation (Protocol 34)
# @name googleSsoInitiate
# Expected Response:
#   HTTP/1.1 302 Found
#   Location: https://accounts.google.com/o/oauth2/v2/auth?...
GET {{authUrl}}/google/sso HTTP/1.1
Accept: text/html,application/xhtml+xml

###

### 9b. Google SSO Callback - Mock Code Flow (Positive)
# @name googleSsoCallbackSuccess
# Expected Response:
#   HTTP/1.1 302 Found
#   Location: .../dashboard
GET {{authUrl}}/google/sso/callback?code={{mockGoogleCode}} HTTP/1.1
Accept: application/json

###

### 9c. Google SSO Callback - Missing Code Rejection (Negative)
# @name googleSsoCallbackMissingCode
# Expected Response:
#   HTTP/1.1 302 Found
#   Location: .../login?error=ACCESS_DENIED
GET {{authUrl}}/google/sso/callback HTTP/1.1
Accept: application/json

