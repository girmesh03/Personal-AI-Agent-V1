### Personal AI Agent (Operon) V1 - Phase 1 Foundational Architecture Tests
### Protocol 24: Deterministic Vertical-Slice Functional Testing (.http)
###
### Usage:
###   1. Start backend server: npm run dev:backend (or node backend/src/server.js)
###   2. Open this file in VS Code and click "Send Request" above any scenario,
###      or execute across the file via REST Client.

@host = http://localhost:4000
@baseUrl = {{host}}/api/v1

### 1. Canonical Health Check Endpoint (Protocol 35)
# @name healthCheck
GET {{baseUrl}}/health HTTP/1.1
Accept: application/json

> {%
client.test("Status code is 200 OK", function() {
    client.assert(response.status === 200, "Response status is not 200");
});

client.test("Response status is UP", function() {
    client.assert(response.body.status === "UP", "Status should be UP");
});

client.test("Response includes valid uptime and environment", function() {
    client.assert(typeof response.body.uptime === "number", "Uptime should be a number");
    client.assert(response.body.environment === "development", "Environment should match development");
});
%}

### 2. Operational API Canary Ping Endpoint
# @name pingCheck
GET {{baseUrl}}/ping HTTP/1.1
Accept: application/json

> {%
client.test("Status code is 200 OK", function() {
    client.assert(response.status === 200, "Response status is not 200");
});

client.test("Ping returns success true", function() {
    client.assert(response.body.success === true, "Response success is not true");
});
%}

### 3. Unmatched Route Handler (Protocol 21, 35 - Uniform 404 Error Envelope)
# @name notFoundCheck
GET {{baseUrl}}/nonexistent-endpoint HTTP/1.1
Accept: application/json

> {%
client.test("Status code is 404 NOT_FOUND", function() {
    client.assert(response.status === 404, "Response status is not 404");
});

client.test("Returns uniform error envelope", function() {
    client.assert(response.body.success === false, "Success should be false");
    client.assert(response.body.error.errorCode === "NOT_FOUND", "Error code should be NOT_FOUND");
    client.assert(response.body.error.statusCode === 404, "Status code in envelope should be 404");
});
%}

### 4. Verify Purge of Legacy /api/health Alias (Protocol 35, 44)
# @name legacyHealthPurged
GET {{host}}/api/health HTTP/1.1
Accept: application/json

> {%
client.test("Legacy /api/health returns 404 NOT_FOUND", function() {
    client.assert(response.status === 404, "Expected 404 confirming legacy alias was eradicated");
});
%}

### 5. Verify Zero Static Local Uploads Exposure (Protocol 43)
# @name staticUploadsPurged
GET {{host}}/uploads/test.png HTTP/1.1
Accept: */*

> {%
client.test("Static /uploads returns 404 NOT_FOUND", function() {
    client.assert(response.status === 404, "Expected 404 confirming static uploads directory was purged");
});
%}
