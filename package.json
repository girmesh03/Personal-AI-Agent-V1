{
  "name": "personal-ai-agent-v1",
  "version": "1.0.0",
  "description": "Personal AI Agent V1 (Operon)",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node backend/scripts/installFonts.js",
    "kill-ports": "node backend/scripts/killPort.js",
    "clean:client": "node client/scripts/cleanDist.js",
    "dev": "node backend/scripts/killPort.js && concurrently -n \"api,web\" -c \"blue,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node backend/scripts/killPort.js 4000 && nodemon backend/src/server.js",
    "dev:web": "node backend/scripts/killPort.js 3000 && vite client",
    "start:api": "node backend/src/server.js",
    "build:web": "vite build client",
    "preview:web": "vite preview client",
    "lint": "eslint client",
    "test:api": "node --test tests/api/**/*.test.js",
    "verify": "npm run lint && npm run build:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@langchain/core": "^1.3.5",
    "@langchain/google": "^0.2.12",
    "@langchain/langgraph": "^1.7.0",
    "@langchain/openai": "^1.8.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.17.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.6.2",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
