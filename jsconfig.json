{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": false,
    "allowJs": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "backend/src/**/*",
    "client/src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "client/dist",
    "logs",
    "backend/uploads"
  ]
}
